# apps/web (.env.local / Vercel env). Host only, no scheme. Scheme is derived:
# http/ws for localhost and LAN IPs, https/wss otherwise.
NEXT_PUBLIC_GAME_HOST=localhost:8787

# apps/server (wrangler vars / .dev.vars)
# Comma-separated exact-match Origin allowlist.
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# CI only (GitHub Actions secrets): CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
# Smoke test (CI env): SMOKE_BASE_URL, SMOKE_ORIGIN
